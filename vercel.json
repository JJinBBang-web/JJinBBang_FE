{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jjinbbang.kr"
        }
      ],
      "destination": "https://www.jjinbbang.kr",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.jjinbbang.kr/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
